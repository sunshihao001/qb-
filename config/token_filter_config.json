{
  "template_name": "SIKK-GMGN 默认筛选 V1",
  "version": "1.0.0",
  "chain": "sol",
  "description": "GMGN 新币/Trenches 第一层候选池筛选。仅负责候选池入口，买卖由后续 SIKK 结构信号、风控门禁与执行状态机决定。",
  "gmgn_query": {
    "type": ["completed"],
    "sort_by": "created_timestamp",
    "direction": "desc",
    "limit": 80
  },
  "thresholds": {
    "market_cap": {"min": 50000, "max": 1500000},
    "liquidity": {"min": 10000, "max": 300000},
    "volume_24h": {"min": 50000},
    "net_buy_24h": {"min": 5000},
    "swaps_24h": {"min": 100},
    "buys_24h": {"min": 60},
    "sells_24h": {"min": 10},
    "top_10_holder_rate": {"max": 0.35},
    "creator_balance_rate": {"max": 0.05},
    "rat_trader_amount_rate": {"max": 0.10},
    "bot_degen_rate": {"max": 0.35},
    "whale_hold_rate": {"max": 0.30},
    "creator_created_count": {"max": 10},
    "rug_ratio": {"max": 0.30}
  },
  "hard_exclude": {
    "min_liquidity_usd": 5000,
    "max_top_10_holder_rate": 0.50,
    "max_creator_balance_rate": 0.15,
    "max_rat_trader_amount_rate": 0.25,
    "max_rug_ratio": 0.30
  },
  "structure_bonus_rules": {
    "smart_degen_count_min": 1,
    "renowned_count_min": 1,
    "renowned_count_max": 5,
    "fresh_wallet_rate_min": 0.10,
    "sniper_count_min": 1,
    "bundler_trader_amount_rate_min": 0.01,
    "positive_net_buy_required": true
  },
  "level_rules": {
    "S3_min_structure_bonus": 2,
    "S2_min_structure_bonus": 1
  },
  "notes": [
    "GMGN 筛选层不单独触发真实买卖。",
    "S3 仅代表进入 SIKK 结构分析，不等于买入。",
    "真实执行必须再经过吸筹窗口、K线结构、钱包结构、风险门禁、仓位和报价安全扫描。"
  ]
}
