{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "wallet_entity_profile",
  "type": "object",
  "description": "钱包画像 normalized contract。",
  "additionalProperties": false,
  "required": [
    "token_address",
    "wallet_address",
    "gmgn_tags",
    "wallet_age_days",
    "wallet_first_seen_time",
    "wallet_last_active_time",
    "total_token_count",
    "traded_token_count",
    "schema_version",
    "source_level",
    "source_name",
    "normalized_at",
    "missing_fields",
    "fallback_used",
    "fallback_source"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "source_level": {
      "type": "string",
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3",
        "L4",
        "unknown"
      ]
    },
    "source_name": {
      "type": "string"
    },
    "raw_snapshot_time": {
      "type": [
        "string",
        "null"
      ]
    },
    "wallet_snapshot_time": {
      "type": [
        "string",
        "null"
      ]
    },
    "retrieved_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "normalized_at": {
      "type": "string"
    },
    "missing_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fallback_used": {
      "type": "boolean"
    },
    "fallback_source": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_level": {
      "type": "string",
      "enum": [
        "E0",
        "E1",
        "E2",
        "E3",
        "E4",
        "E5",
        "unknown"
      ]
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3",
        "R4",
        "unknown"
      ]
    },
    "token_address": {
      "type": [
        "string",
        "null"
      ]
    },
    "wallet_address": {
      "type": [
        "string",
        "null"
      ]
    },
    "gmgn_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "wallet_age_days": {
      "type": [
        "number",
        "null"
      ]
    },
    "wallet_first_seen_time": {
      "type": [
        "string",
        "null"
      ]
    },
    "wallet_last_active_time": {
      "type": [
        "string",
        "null"
      ]
    },
    "total_token_count": {
      "type": [
        "integer",
        "null"
      ]
    },
    "traded_token_count": {
      "type": [
        "integer",
        "null"
      ]
    },
    "is_fresh_wallet": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "is_smart_money": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "is_whale": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "is_sniper": {
      "type": [
        "boolean",
        "null"
      ]
    }
  }
}