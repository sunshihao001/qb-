{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "bot2_handoff_packet",
  "type": "object",
  "description": "Bot1 到 Bot2 的结构证据交接包 contract。",
  "additionalProperties": false,
  "required": [
    "token_address",
    "packet_id",
    "wallet_trade_refs",
    "wallet_intelligence_refs",
    "evidence_language_only",
    "schema_version",
    "source_level",
    "source_name",
    "normalized_at",
    "missing_fields",
    "fallback_used",
    "fallback_source"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "source_level": {
      "type": "string",
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3",
        "L4",
        "unknown"
      ]
    },
    "source_name": {
      "type": "string"
    },
    "raw_snapshot_time": {
      "type": [
        "string",
        "null"
      ]
    },
    "wallet_snapshot_time": {
      "type": [
        "string",
        "null"
      ]
    },
    "retrieved_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "normalized_at": {
      "type": "string"
    },
    "missing_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fallback_used": {
      "type": "boolean"
    },
    "fallback_source": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_level": {
      "type": "string",
      "enum": [
        "E0",
        "E1",
        "E2",
        "E3",
        "E4",
        "E5",
        "unknown"
      ]
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3",
        "R4",
        "unknown"
      ]
    },
    "token_address": {
      "type": [
        "string",
        "null"
      ]
    },
    "packet_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "wallet_trade_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "wallet_intelligence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_language_only": {
      "type": "boolean"
    },
    "forbidden_decision_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}