  "additionalProperties": true,
  "properties": {
    "acceptance": {
      "type": "object"
    },
    "handoff": {
      "type": "object"
    },
    "phase_id": {
      "const": "P09"
    },
    "runtime_mode": {
      "const": "paper_only"
    },
