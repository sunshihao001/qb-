{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sikk-gmgn.local/schemas/harness/task_ticket.schema.json",
  "title": "HER Harness Task Ticket",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "title",
    "bot",
    "asset_type",
    "asset_id",
    "mode",
    "input_root",
    "output_root",
    "allowed_paths",
    "forbidden_paths",
    "required_outputs",
    "phase",
    "created_at"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "bot": {
      "type": "string",
      "enum": [
        "source_wallet_bot",
        "intel_bot",
        "strategy_gate_bot",
        "execution_risk_bot",
        "review_ops_bot",
        "her_harness"
      ]
    },
    "asset_type": {
      "type": "string",
      "enum": [
        "token",
        "wallet",
        "import",
        "methodology",
        "report",
        "state",
        "manifest",
        "unknown"
      ]
    },
    "asset_id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "minLength": 1
    },
    "input_root": {
      "type": "string",
      "minLength": 1
    },
    "output_root": {
      "type": "string",
      "minLength": 1
    },
    "allowed_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "forbidden_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_outputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "phase": {
      "type": "string",
      "enum": [
        "plan",
        "execute",
        "verify",
        "accept"
      ]
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
