{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sikk-gmgn.local/schemas/harness/file_manifest.schema.json",
  "title": "HER Harness File Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_id",
    "asset_type",
    "asset_id",
    "bot",
    "root",
    "files",
    "generated_at"
  ],
  "properties": {
    "manifest_id": {
      "type": "string",
      "minLength": 1
    },
    "asset_type": {
      "type": "string",
      "minLength": 1
    },
    "asset_id": {
      "type": "string",
      "minLength": 1
    },
    "bot": {
      "type": "string",
      "minLength": 1
    },
    "root": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "source_package": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "logical_name",
          "relative_path",
          "role",
          "required"
        ],
        "properties": {
          "logical_name": {
            "type": "string",
            "minLength": 1
          },
          "relative_path": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "source_path": {
            "type": "string"
          },
          "comments": {
            "type": "string"
          }
        }
      }
    }
  }
}
