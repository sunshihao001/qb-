{
  "contract_name": "source_wallet_bot_data_dependency_contract_v1",
  "version": "1.0.0",
  "scope": "Source Wallet Bot 钱包结构分析前置数据依赖合同",
  "principles": [
    "先证据，后判断",
    "先字段，后角色",
    "字段缺失时先降级，不强判",
    "事实层与推断层分离",
    "原始数据、标准化字段、结构用途必须同时保留",
    "接口能力清单先于采集脚本"
  ],
  "standard_layers": [
    "judgment_target",
    "required_fields",
    "optional_fields",
    "upstream_sources",
    "raw_data_shape",
    "normalized_fields",
    "analysis_usage",
    "degradation_rules",
    "question_name",
    "question_to_answer",
    "question_group",
    "evidence_level",
    "interface_capability_inventory"
  ],
  "source_priority": [
    "GMGN token info",
    "GMGN security",
    "GMGN pool / liquidity",
    "GMGN holders",
    "GMGN traders",
    "GMGN wallet profile",
    "GMGN activity",
    "GMGN market kline",
    "链上 tx / trace",
    "内部历史库"
  ],
  "judgment_targets": [
    {
      "target_name": "疑似同源钱包",
      "judgment_target": "多个钱包是否来自同一资金部署或同一执行组",
      "required_fields": [
        "资金来源地址",
        "首次入金时间",
        "入金金额",
        "买入时间",
        "买入 token",
        "买入金额",
        "交易路径"
      ],
      "optional_fields": [
        "Gas 模式",
        "交易频率",
        "钱包创建时间",
        "是否同步买入",
        "是否同步卖出",
        "是否共同接收资金",
        "是否共享中转节点"
      ],
      "upstream_sources": [
        "GMGN holders",
        "GMGN traders",
        "GMGN wallet profile",
        "链上 tx / trace",
        "内部 address edge history"
      ],
      "raw_data_shape": [
        "入金 tx",
        "转账事件",
        "买入事件",
        "钱包创建事件",
        "边关系记录"
      ],
      "normalized_fields": [
        "funding_source_address",
        "first_funding_time",
        "first_funding_amount",
        "first_buy_time",
        "first_buy_token",
        "first_buy_amount",
        "tx_path",
        "gas_pattern",
        "wallet_create_time",
        "synchronous_buy_flag",
        "synchronous_sell_flag",
        "shared_funding_flag",
        "shared_intermediate_node_flag"
      ],
      "analysis_usage": "生成同源执行组、同源候选组、资金待查组",
      "degradation_rules": "缺少资金来源或链上路径时，只能写同步买入候选组或资金待查组，不得强判同源",
      "group": "资金判断"
    },
    {
      "target_name": "同步执行候选组",
      "judgment_target": "是否存在同一时间窗口内的批量执行行为",
      "required_fields": [
        "买入时间",
        "买入 token",
        "买入金额",
        "钱包创建时间",
        "是否新钱包"
      ],
      "optional_fields": [
        "资金来源",
        "Gas 模式",
        "转入金额",
        "转入时间",
        "GMGN bundler/sniper/fresh 标签"
      ],
      "upstream_sources": [
        "GMGN traders",
        "GMGN holders",
        "GMGN tags",
        "链上 tx"
      ],
      "raw_data_shape": [
        "同窗口交易行",
        "地址标签",
        "资金边"
      ],
      "normalized_fields": [
        "first_buy_time",
        "buy_time_bucket",
        "wallet_create_time",
        "is_new_wallet",
        "same_window_group_id",
        "buy_amount_bucket",
        "gmgn_tags"
      ],
      "analysis_usage": "识别批量执行、狙击批次、临时执行钱包",
      "degradation_rules": "只能降级为时间接近候选组，不能写同源组",
      "group": "基础判断"
    },
    {
      "target_name": "疑似临时执行钱包",
      "judgment_target": "钱包是否为临时创建、短期使用、完成买卖后退出",
      "required_fields": [
        "钱包创建时间",
        "首次买入时间",
        "持有时长",
        "资金转入时间",
        "资金转出时间"
      ],
      "optional_fields": [
        "单 token 参与度",
        "历史复现",
        "是否仅服务单次事件",
        "卖出后余额变化"
      ],
      "upstream_sources": [
        "GMGN wallet profile",
        "GMGN activity",
        "链上 tx"
      ],
      "raw_data_shape": [
        "钱包创建记录",
        "买卖记录",
        "转账记录"
      ],
      "normalized_fields": [
        "wallet_create_time",
        "first_buy_time",
        "holding_duration_type",
        "funding_before_buy_minutes",
        "total_transfer_out",
        "single_token_only_flag"
      ],
      "analysis_usage": "区分执行钱包与普通散户",
      "degradation_rules": "缺少创建时间或转账路径时，只能写临时执行候选",
      "group": "基础判断"
    },
    {
      "target_name": "疑似新钱包狙击",
      "judgment_target": "新钱包是否在早期窗口快速买入",
      "required_fields": [
        "钱包创建时间",
        "首次买入时间",
        "买入延迟",
        "买入金额",
        "买入市值阶段"
      ],
      "optional_fields": [
        "bundler/sniper/fresh 标签",
        "是否同批入场",
        "是否高频短持"
      ],
      "upstream_sources": [
        "GMGN traders",
        "GMGN wallet profile",
        "GMGN market kline"
      ],
      "raw_data_shape": [
        "钱包画像",
        "交易时间戳",
        "K线阶段"
      ],
      "normalized_fields": [
        "wallet_create_time",
        "first_buy_time",
        "first_buy_delay_minutes",
        "entry_stage",
        "is_new_wallet",
        "is_sniper",
        "gmgn_tags"
      ],
      "analysis_usage": "锁定 W1/W2 早期狙击钱包",
      "degradation_rules": "没有创建时间时，只能写早期买入候选，不能直接写新狙击",
      "group": "基础判断"
    },
    {
      "target_name": "Token 接收钱包 / 被动接收钱包",
      "judgment_target": "地址持有 token 是主动买入还是被动收到",
      "required_fields": [
        "Token 来源",
        "转入时间",
        "转入金额",
        "是否有主动 swap 买入"
      ],
      "optional_fields": [
        "空投标记",
        "分发标记",
        "LP/池交互",
        "Token 去向"
      ],
      "upstream_sources": [
        "GMGN activity",
        "GMGN holders",
        "链上 transfer trace"
      ],
      "raw_data_shape": [
        "token transfer",
        "holder 变动",
        "交易事件"
      ],
      "normalized_fields": [
        "token_source_type",
        "token_source_address",
        "token_source_time",
        "token_source_amount",
        "is_transferred_token",
        "is_airdrop_token",
        "is_distributed_token",
        "is_market_buy_token"
      ],
      "analysis_usage": "区分主动买盘与被动接收噪音",
      "degradation_rules": "无法确认主动买入时，只能写 Token 接收钱包或待查",
      "group": "资金判断"
    },
    {
      "target_name": "疑似分发接收 / 分发派发钱包",
      "judgment_target": "钱包是否处于 token 分发链条的接收端或派发端",
      "required_fields": [
        "Token 来源",
        "转入来源",
        "后续卖出 / 转出",
        "卖出时间",
        "卖出数量"
      ],
      "optional_fields": [
        "是否同一上游分发源",
        "是否多地址接收",
        "是否后续集中卖出",
        "是否回流"
      ],
      "upstream_sources": [
        "GMGN activity",
        "GMGN holders",
        "链上 trace"
      ],
      "raw_data_shape": [
        "distribution tx",
        "sell tx",
        "转出边"
      ],
      "normalized_fields": [
        "token_source_type",
        "token_source_address",
        "token_out_type",
        "token_out_address",
        "first_sell_time",
        "is_partial_exit",
        "is_full_exit"
      ],
      "analysis_usage": "识别早期分发、派发出货、接盘风险",
      "degradation_rules": "只看到接收而无后续卖出时，只能写分发接收候选",
      "group": "资金判断"
    },
    {
      "target_name": "早期结构资金是否还没出完",
      "judgment_target": "早期买入资金是否仍留在持仓中，还是已开始派发",
      "required_fields": [
        "早期买入钱包列表",
        "初始买入数量",
        "当前剩余持仓",
        "已卖出数量"
      ],
      "optional_fields": [
        "卖出时间",
        "卖出价格",
        "是否仍在 Top Holder",
        "是否转移到新钱包",
        "是否分发给接盘钱包"
      ],
      "upstream_sources": [
        "GMGN holders",
        "GMGN traders",
        "GMGN wallet profile",
        "历史边库"
      ],
      "raw_data_shape": [
        "持仓快照",
        "卖出事件",
        "地址关系边",
        "Top Holder 变动"
      ],
      "normalized_fields": [
        "early_wallet_list",
        "initial_buy_amount",
        "current_position_remaining",
        "sold_amount",
        "last_sell_time",
        "last_sell_price",
        "is_top_holder_now",
        "transferred_to_new_wallet_flag",
        "distributed_to_bagholder_flag",
        "holding_change_trend"
      ],
      "analysis_usage": "判断派发是否结束、是否仍有结构筹码未出完",
      "degradation_rules": "缺少剩余持仓或卖出事件时，只能写早期结构资金待查",
      "group": "资金判断"
    },
    {
      "target_name": "结果钱包 / 高结果鲸鱼",
      "judgment_target": "钱包是否具备稳定盈利结果，或属于高结果鲸鱼",
      "required_fields": [
        "已实现利润",
        "未实现利润",
        "总利润",
        "胜率",
        "样本数",
        "历史复现"
      ],
      "optional_fields": [
        "进入时间",
        "退出质量",
        "是否稳定复现",
        "是否单次暴富"
      ],
      "upstream_sources": [
        "GMGN wallet profile",
        "GMGN traders",
        "内部历史库"
      ],
      "raw_data_shape": [
        "盈亏页",
        "历史收益记录",
        "持仓记录"
      ],
      "normalized_fields": [
        "realized_profit",
        "unrealized_profit",
        "total_profit",
        "winrate",
        "sample_count",
        "entry_time",
        "exit_quality",
        "historical_recurrence_flag"
      ],
      "analysis_usage": "区分结果钱包、高结果鲸鱼、单次暴富钱包",
      "degradation_rules": "样本数不足时只能写结果钱包候选或单次暴富候选",
      "group": "结果判断"
    },
    {
      "target_name": "接盘鲸鱼 / 套牢鲸鱼",
      "judgment_target": "是否高位接盘、浮亏、套牢、买在派发后段",
      "required_fields": [
        "买入市值",
        "买入时间",
        "持有时长",
        "未实现利润",
        "当前持仓占比"
      ],
      "optional_fields": [
        "后续卖出情况",
        "历史胜率",
        "是否在早期钱包卖出后入场"
      ],
      "upstream_sources": [
        "GMGN traders",
        "GMGN holders",
        "GMGN market kline"
      ],
      "raw_data_shape": [
        "买入行",
        "持仓快照",
        "K线阶段"
      ],
      "normalized_fields": [
        "entry_stage",
        "avg_buy_market_cap",
        "holding_duration_type",
        "unrealized_profit",
        "current_holding_pct",
        "exit_status"
      ],
      "analysis_usage": "识别高位接盘、套牢、风险观察",
      "degradation_rules": "没有持仓收益数据时，只能写接盘风险候选",
      "group": "风险判断"
    },
    {
      "target_name": "基础设施地址",
      "judgment_target": "地址是否属于 CEX、LP、池子、路由、程序、可疑中转、回收节点、分发源",
      "required_fields": [
        "地址类型",
        "出现代币数",
        "对手方数",
        "边关系数",
        "路由 / 池交互数"
      ],
      "optional_fields": [
        "回流次数",
        "资金源次数",
        "是否多 token 重复出现",
        "是否连接执行组"
      ],
      "upstream_sources": [
        "链上 trace",
        "GMGN activity",
        "内部边库"
      ],
      "raw_data_shape": [
        "地址标签",
        "交易路径",
        "边关系",
        "转账节点"
      ],
      "normalized_fields": [
        "entity_type",
        "entity_name",
        "infrastructure_level",
        "exclusion_reason",
        "appeared_token_count",
        "counterparty_count",
        "funding_source_count",
        "return_flow_count",
        "router_interaction_count",
        "lp_interaction_count",
        "keep_edges"
      ],
      "analysis_usage": "排除普通钱包评分，只保留关系边和结构节点证据",
      "degradation_rules": "类型未明确时，只能写可疑中转候选或待复查节点",
      "group": "基础设施"
    },
    {
      "target_name": "利润回收 / 核心资金源",
      "judgment_target": "多个钱包卖出后是否回到同一地址，是否形成核心资金源",
      "required_fields": [
        "卖后回流边",
        "回流地址",
        "回流金额",
        "回流时间",
        "关联钱包数"
      ],
      "optional_fields": [
        "多 token 复现",
        "同源执行组",
        "CEX 入口",
        "重复回流模式"
      ],
      "upstream_sources": [
        "链上 trace",
        "内部边库",
        "历史库"
      ],
      "raw_data_shape": [
        "卖后转账",
        "回流边",
        "资金树"
      ],
      "normalized_fields": [
        "return_flow_address",
        "return_flow_amount",
        "return_flow_count",
        "is_return_flow",
        "core_funding_source_flag"
      ],
      "analysis_usage": "识别利润归集、核心资金源、回收地址",
      "degradation_rules": "若只有单次回流，写利润回流候选；不得直接写核心资金源",
      "group": "资金判断"
    }
  ],
  "unified_degradation_rules": [
    {
      "missing_condition": "没有资金来源",
      "max_conclusion": "资金待查 / 同步候选",
      "forbidden": [
        "同源钱包",
        "核心资金源"
      ]
    },
    {
      "missing_condition": "没有链上路径",
      "max_conclusion": "时间接近候选",
      "forbidden": [
        "同源组",
        "回流组"
      ]
    },
    {
      "missing_condition": "没有钱包创建时间",
      "max_conclusion": "早期买入候选",
      "forbidden": [
        "新钱包狙击"
      ]
    },
    {
      "missing_condition": "没有持仓收益数据",
      "max_conclusion": "结果候选",
      "forbidden": [
        "高结果鲸鱼",
        "稳定结果"
      ]
    },
    {
      "missing_condition": "没有卖出事件",
      "max_conclusion": "持有中 / 待查",
      "forbidden": [
        "清仓",
        "分发结束"
      ]
    },
    {
      "missing_condition": "没有 Token 来源",
      "max_conclusion": "事实待查",
      "forbidden": [
        "主动买入",
        "Token 接收确认"
      ]
    },
    {
      "missing_condition": "没有边关系",
      "max_conclusion": "单钱包记录",
      "forbidden": [
        "同源组",
        "回收节点",
        "结构网络节点"
      ]
    }
  ],
  "recommended_storage_paths": {
    "human_readable": "docs/source_wallet_bot/directory_governance/data_dependency_map_v1.md",
    "machine_readable": "docs/source_wallet_bot/directory_governance/data_dependency_contract_v1.json",
    "future_field_map": "research_loop/methodology/field_maps/source_wallet_bot_data_dependency_map_v1.md"
  },
