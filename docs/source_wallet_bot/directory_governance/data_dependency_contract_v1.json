      ],
      "upstream_sources": [
        "GMGN traders",
        "GMGN holders",
        "GMGN market kline",
        "GMGN wallet profile"
      ],
      "raw_data_shape": [
        "交易者行",
        "持仓快照",
        "K线阶段",
        "钱包画像"
      ],
      "normalized_fields": [
        "wallet_address",
        "token_open_time",
        "first_buy_time",
        "first_buy_delay_seconds",
