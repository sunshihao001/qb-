      ],
      "upstream_sources": [
        "GMGN wallet profile",
        "GMGN traders",
        "GMGN holders",
        "GMGN activity",
        "链上 tx / trace",
        "内部历史库"
      ],
      "raw_data_shape": [
        "钱包画像",
        "交易行",
        "transfer 事件",
        "资金边",
        "历史地址画像"
      ],
      "normalized_fields": [
