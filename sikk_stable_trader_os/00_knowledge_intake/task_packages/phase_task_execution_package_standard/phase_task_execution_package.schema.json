      "level_1_goal",
      "level_2_sub_goals",
      "level_3_tasks"
    ],
    "level_1_goal_required": [
      "id",
      "name",
      "required"
    ],
    "level_2_sub_goal_required": [
      "id",
      "name",
      "required"
    ],
    "level_3_task_required": [
      "id",
      "parent",
      "action",
      "output"
    ],
    "parent_binding_rule": "Every level_3_tasks[].parent must reference an existing level_2_sub_goals[].id.",
    "k00_required_outputs": [
      "raw_inputs/<doc_id>.md",
      "source_registry/source_registry.json",
      "document_passports/document_passport_<doc_id>.yaml",
      "system_mapping/plane_mapping_<doc_id>.json",
      "system_mapping/phase_mapping_<doc_id>.json",
      "gap_detection/gap_detection_<doc_id>.json",
      "task_packages/task_execution_package_<doc_id>.json",
      "handoff_packets/k00_handoff_packet_<doc_id>.json"
    ]
  },
