{
  "type": "object",
  "required": [
    "phase_id",
    "phase_status",
    "doc_id",
    "raw_input_path",
    "document_passport_path",
    "task_execution_package_path",
    "affected_planes",
    "affected_phases",
    "gap_list",
    "next_phase_allowed",
    "next_phase_recommendation",
    "generated_at",
    "auto_trigger_decision_path",
    "auto_trigger_decision_status"
  ],
  "properties": {
    "phase_id": {
      "type": "string"
    },
    "phase_status": {
      "type": "string",
      "enum": [
        "PHASE_READY",
        "PHASE_WITH_GAPS",
        "PHASE_PAUSED",
        "PHASE_REJECTED",
        "PHASE_ERROR"
      ]
    },
    "doc_id": {
      "type": "string"
    },
    "raw_input_path": {
      "type": "string"
    },
    "document_passport_path": {
      "type": "string"
    },
    "task_execution_package_path": {
      "type": "string",
      "description": "必须指向符合 task_execution_package.schema.json 的 task_packages/task_execution_package_<doc_id>.json"
    },
    "affected_planes": {
      "type": "array"
    },
    "affected_phases": {
      "type": "array"
    },
    "gap_list": {
      "type": "array"
    },
    "next_phase_allowed": {
      "type": "boolean"
    },
    "next_phase_recommendation": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "auto_trigger_decision_path": {
      "type": "string",
      "description": "K00 gate-derived auto-trigger decision artifact path"
    },
    "auto_trigger_decision_status": {
      "type": "string",
      "enum": [
        "AUTO_TRIGGER_ALLOWED",
        "AUTO_TRIGGER_BLOCKED",
        "AUTO_TRIGGER_NOT_EVALUATED"
      ]
    }
  },
  "task_execution_package_schema_ref": "00_knowledge_intake/task_packages/phase_task_execution_package_standard/task_execution_package.schema.json",
  "auto_trigger_handoff_contract": {
    "next_phase_allowed_must_match_decision_artifact": true,
    "direct_trade_execution_forbidden": true
  }
}
