{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sikk-stable-trader-os/k00/document_passport.schema.json",
  "title": "K00 Document Passport",
  "type": "object",
  "required": [
    "document_passport"
  ],
  "additionalProperties": false,
  "properties": {
    "document_passport": {
      "type": "object",
      "required": [
        "doc_id",
        "source_type",
        "source_name",
        "received_at",
        "raw_path",
        "document_role",
        "summary",
        "system_mapping",
        "required_actions",
        "evidence_level",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "doc_id": {
          "type": "string",
          "pattern": "^DOC-[0-9]{8}-[0-9]{3,}$"
        },
        "source_type": {
          "type": "string"
        },
        "source_name": {
          "type": "string"
        },
        "received_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "raw_path": {
          "type": "string",
          "pattern": "^00_knowledge_intake/raw_inputs/.+"
        },
        "document_role": {
          "type": "object",
          "required": [
            "primary_role",
            "secondary_roles"
          ],
          "additionalProperties": false,
          "properties": {
            "primary_role": {
              "type": "string"
            },
            "secondary_roles": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "summary": {
          "type": "object",
          "required": [
            "core_intent",
            "key_points"
          ],
          "additionalProperties": false,
          "properties": {
            "core_intent": {
              "type": "string"
            },
            "key_points": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "system_mapping": {
          "type": "object",
          "required": [
            "planes",
            "affected_phases"
          ],
          "additionalProperties": false,
          "properties": {
            "planes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "affected_phases": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "required_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_level": {
          "type": "string",
          "enum": [
            "EVIDENCE_A_STRONG",
            "EVIDENCE_B_MEDIUM",
            "EVIDENCE_C_WEAK",
            "EVIDENCE_D_UNVERIFIED"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "PASSPORT_READY",
            "PASSPORT_DRAFT",
            "PASSPORT_REJECTED",
            "PASSPORT_SUPERSEDED"
          ]
        }
      }
    }
  }
}