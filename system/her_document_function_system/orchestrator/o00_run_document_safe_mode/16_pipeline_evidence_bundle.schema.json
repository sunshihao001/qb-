{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "O00 evidence bundle",
  "type": "object",
  "required": [
    "pipeline_run_id",
    "status",
    "evidence_refs",
    "gap_refs",
    "trace_refs"
  ],
  "properties": {
    "pipeline_run_id": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "gap_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "trace_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}