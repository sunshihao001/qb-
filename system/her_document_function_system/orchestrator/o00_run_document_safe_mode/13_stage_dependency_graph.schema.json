{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "O00 stage dependency graph",
  "type": "object",
  "required": [
    "nodes",
    "edges"
  ],
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "dependency_type": {
            "type": "string"
          }
        }
      }
    },
    "skipped_nodes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocked_nodes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}