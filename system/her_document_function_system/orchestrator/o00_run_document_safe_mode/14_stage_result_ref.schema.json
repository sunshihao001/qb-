{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "O00 stage result reference",
  "type": "object",
  "required": [
    "stage",
    "status",
    "real_runtime_executed"
  ],
  "properties": {
    "stage": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "run_type": {
      "type": "string"
    },
    "real_runtime_executed": {
      "type": "boolean"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "gap_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}