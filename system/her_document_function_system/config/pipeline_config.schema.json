{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HER Document Function System Pipeline Config",
  "type": "object",
  "required": [
    "config_id",
    "config_version",
    "pipeline_name",
    "safe_mode",
    "repo_root",
    "controller_registry_ref",
    "governance_policy_ref",
    "execution_boundary",
    "write_policy",
    "stage_plan",
    "failure_policy",
    "gap_policy",
    "acceptance_policy"
  ],
  "properties": {
    "config_id": {
      "type": "string"
    },
    "config_version": {
      "type": "string"
    },
    "pipeline_name": {
      "type": "string"
    },
    "safe_mode": {
      "type": "boolean"
    },
    "repo_root": {
      "type": "string"
    },
    "controller_registry_ref": {
      "type": "string"
    },
    "governance_policy_ref": {
      "type": "string"
    },
    "execution_boundary": {
      "type": "object"
    },
    "write_policy": {
      "type": "object"
    },
    "stage_plan": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "stage_id",
          "required",
          "mode",
          "entry_condition",
          "exit_condition",
          "on_success",
          "on_failure"
        ],
        "properties": {
          "stage_id": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "mode": {
            "type": "string"
          },
          "entry_condition": {
            "type": "string"
          },
          "exit_condition": {
            "type": "string"
          },
          "on_success": {
            "type": "string"
          },
          "on_failure": {
            "type": "string"
          },
          "skip_condition": {
            "type": "string"
          }
        }
      }
    },
    "failure_policy": {
      "type": "object"
    },
    "gap_policy": {
      "type": "object"
    },
    "acceptance_policy": {
      "type": "object"
    }
  }
}