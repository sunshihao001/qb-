{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Binding target inventory schema",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "binding_target_inventory"
  ],
  "properties": {
    "binding_target_inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "function_id",
          "recommended_targets",
          "excluded_targets",
          "reason"
        ],
        "properties": {
          "function_id": {
            "type": "string"
          },
          "recommended_targets": {
            "type": "array"
          },
          "excluded_targets": {
            "type": "array"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  }
}
