{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dependency graph",
  "type": "object",
  "required": [
    "graph_id",
    "nodes",
    "edges",
    "blocked_nodes",
    "execution_order"
  ],
  "properties": {
    "graph_id": {
      "type": "string"
    },
    "nodes": {
      "type": "array"
    },
    "edges": {
      "type": "array"
    },
    "blocked_nodes": {
      "type": "array"
    },
    "execution_order": {
      "type": "array"
    }
  },
  "additionalProperties": true
}