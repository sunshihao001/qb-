{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "V00 Contract Validation Evidence Schema",
  "type": "object",
  "required": [
    "validation_type",
    "status",
    "input_contract_status",
    "output_contract_status",
    "handoff_contract_status",
    "errors"
  ],
  "properties": {
    "validation_type": {
      "const": "contract_validation"
    },
    "status": {
      "enum": [
        "PASSED",
        "FAILED",
        "BLOCKED",
        "READY_WITH_GAPS"
      ]
    },
    "input_contract_status": {
      "enum": [
        "PASSED",
        "FAILED",
        "BLOCKED",
        "NOT_CHECKED"
      ]
    },
    "output_contract_status": {
      "enum": [
        "PASSED",
        "FAILED",
        "BLOCKED",
        "NOT_CHECKED"
      ]
    },
    "handoff_contract_status": {
      "enum": [
        "PASSED",
        "FAILED",
        "BLOCKED",
        "NOT_CHECKED"
      ]
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "gap_preserved": {
      "type": "boolean"
    },
    "allowed_forbidden_actions_present": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}
