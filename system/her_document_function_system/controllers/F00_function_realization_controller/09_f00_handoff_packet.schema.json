{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "F00 Handoff Packet Schema",
  "type": "object",
  "required": [
    "from_phase",
    "to_phase",
    "source_doc_refs",
    "function_mapping_refs",
    "implementation_decision_refs",
    "asset_plan_refs",
    "gap_refs",
    "allowed_next_actions",
    "forbidden_next_actions",
    "unresolved_gaps",
    "status"
  ],
  "properties": {
    "from_phase": {
      "const": "F00"
    },
    "to_phase": {
      "type": "string",
      "enum": [
        "F03",
        "F04",
        "F05",
        "F06",
        "R01",
        "A01"
      ]
    },
    "source_doc_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "registry_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "passport_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "corpus_index_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "system_mapping_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "function_mapping_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "implementation_decision_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "asset_plan_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "KV_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "gap_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_next_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "forbidden_next_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unresolved_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "FUNCTION_MAPPED",
        "FUNCTION_BLOCKED",
        "READY_WITH_GAPS"
      ]
    }
  },
  "additionalProperties": false
}