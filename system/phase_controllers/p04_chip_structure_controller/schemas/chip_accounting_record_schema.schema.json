{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chip Accounting Record",
  "description": "P04 structure-state record. Candidate-only and trace-required.",
  "type": "object",
  "required": [
    "record_id",
    "wallet_entity_id",
    "buy_amount",
    "sell_amount",
    "transfer_out_amount",
    "transfer_in_amount",
    "current_explainable_holding",
    "accounting_matched",
    "trace_ids"
  ],
  "properties": {
    "record_id": {
      "type": "string"
    },
    "token_address": {
      "type": [
        "string",
        "null"
      ]
    },
    "snapshot_time": {
      "type": [
        "string",
        "null"
      ]
    },
    "cohort_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "wallet_entity_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "candidate_only": {
      "const": true
    },
    "source_record_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "trace_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "quality_level": {
      "type": "string",
      "enum": [
        "BLOCKED",
        "LOW",
        "MEDIUM",
        "HIGH",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ]
    },
    "created_at": {
      "type": "string"
    },
    "buy_amount": {
      "type": [
        "number",
        "null"
      ]
    },
    "sell_amount": {
      "type": [
        "number",
        "null"
      ]
    },
    "transfer_out_amount": {
      "type": [
        "number",
        "null"
      ]
    },
    "transfer_in_amount": {
      "type": [
        "number",
        "null"
      ]
    },
    "current_explainable_holding": {
      "type": [
        "number",
        "null"
      ]
    },
    "accounting_matched": {
      "type": "boolean"
    },
    "accounting_gap": {
      "type": [
        "number",
        "null"
      ]
    },
    "unexplained_flow": {
      "type": [
        "array",
        "null"
      ]
    },
    "unknown_transfer_target": {
      "type": [
        "array",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
