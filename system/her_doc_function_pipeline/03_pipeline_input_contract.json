      "description": "真实 GPT 研究资料、系统建设资料或方法论文档"
    },
    "operator_goal": {
      "required": true,
      "description": "本次文档希望落实到系统中的目标"
    },
    "repo_root": {
      "required": true,
      "default": "/root/sikk-gmgn"
