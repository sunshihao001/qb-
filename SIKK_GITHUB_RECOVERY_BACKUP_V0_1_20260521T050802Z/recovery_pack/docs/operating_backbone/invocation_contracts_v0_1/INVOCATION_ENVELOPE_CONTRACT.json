{
  "artifact_id": "INVOCATION_ENVELOPE_CONTRACT_V0_1",
  "artifact_type": "contract_schema",
  "version": "0.1",
  "purpose": "Define the required pre-runtime invocation envelope for Orchestrator Skeleton Gate and Storage Policy Gate.",
  "contract_owner": "OBN-00 control_plane",
  "required_fields": [
    "artifact_type",
    "version",
    "run_id",
    "skill_id",
    "expected_backbone_node",
    "allowed_scope",
    "forbidden_scope",
    "input_artifacts",
    "output_artifacts",
    "downstream_consumers",
    "invocation_context",
    "artifact_class",
    "target_paths",
    "read_paths",
    "promotion_requested",
    "canonical_write_requested",
    "execution_requested",
    "runtime_action_allowed"
