{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "token_source_normalized.json",
  "type": "object",
  "description": "Token 来源与转入转出路径 normalized contract。",
  "additionalProperties": false,
  "required": [
    "token_address",
    "wallet_address",
    "token_transfer_edges",
    "schema_version",
    "source_level",
    "source_name",
    "normalized_at",
    "missing_fields",
    "fallback_used",
    "fallback_source"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "source_level": {
      "type": "string",
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3",
        "L4",
        "unknown"
      ]
    },
    "source_name": {
      "type": "string"
    },
    "raw_snapshot_time": {
      "type": [
        "string",
        "null"
      ]
    },
    "wallet_snapshot_time": {
      "type": [
        "string",
        "null"
      ]
    },
    "retrieved_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "normalized_at": {
      "type": "string"
    },
    "missing_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fallback_used": {
      "type": "boolean"
    },
    "fallback_source": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_level": {
      "type": "string",
      "enum": [
        "E0",
        "E1",
        "E2",
        "E3",
        "E4",
        "E5",
        "unknown"
      ]
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3",
        "R4",
        "unknown"
      ]
    },
    "token_address": {
      "type": [
        "string",
        "null"
      ]
    },
    "wallet_address": {
      "type": [
        "string",
        "null"
      ]
    },
    "token_transfer_edges": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "transfer_in_from_address": {
      "type": [
        "string",
        "null"
      ]
    },
    "transfer_out_to_address": {
      "type": [
        "string",
        "null"
      ]
    },
    "token_source_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "amount_percentage": {
      "type": [
        "number",
        "null"
      ]
    },
    "sell_amount_percentage": {
      "type": [
        "number",
        "null"
      ]
    }
  }
}