{
  "contract_name": "phase_01_input_contract",
  "version": "v1.0",
  "phase_id": "phase_01_data_fact_controller",
  "required_config": [
    "run_id",
    "token_address",
    "chain",
    "run_mode",
    "data_snapshot_time"
  ],
  "optional_sources": [
    "gmgn_traders",
    "gmgn_holders",
    "chain_transfers",
    "quote_snapshot",
    "security_snapshot",
    "history_database"
  ],
  "accepted_formats": [
    "json",
    "csv",
    "md",
    "jsonl"
  ],
  "forbidden": [
    "private_key",
    "seed_phrase",
    "signed_transaction",
    "swap_execution"
  ],
  "missing_rule": "任何缺失字段必须显式写为 missing，不允许用 0 或空字符串替代。"
}
