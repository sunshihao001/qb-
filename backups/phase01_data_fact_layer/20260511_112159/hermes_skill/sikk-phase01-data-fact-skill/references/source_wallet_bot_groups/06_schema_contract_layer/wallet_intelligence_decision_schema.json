{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "wallet_intelligence_decision",
  "type": "object",
  "description": "钱包情报决策输出 contract，仅允许证据语言。",
  "additionalProperties": false,
  "required": [
    "token_address",
    "wallet_address",
    "role_candidates",
    "evidence_level",
    "risk_level",
    "schema_version",
    "source_level",
    "source_name",
    "normalized_at",
    "missing_fields",
    "fallback_used",
    "fallback_source"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "source_level": {
      "type": "string",
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3",
        "L4",
        "unknown"
      ]
    },
    "source_name": {
      "type": "string"
    },
    "raw_snapshot_time": {
      "type": [
        "string",
        "null"
      ]
    },
    "wallet_snapshot_time": {
      "type": [
        "string",
        "null"
      ]
    },
    "retrieved_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "normalized_at": {
      "type": "string"
    },
    "missing_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fallback_used": {
      "type": "boolean"
    },
    "fallback_source": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_level": {
      "type": "string",
      "enum": [
        "E0",
        "E1",
        "E2",
        "E3",
        "E4",
        "E5",
        "unknown"
      ]
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3",
        "R4",
        "unknown"
      ]
    },
    "token_address": {
      "type": [
        "string",
        "null"
      ]
    },
    "wallet_address": {
      "type": [
        "string",
        "null"
      ]
    },
    "role_candidates": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "疑似结构执行钱包",
          "疑似同源执行组",
          "疑似分发接收钱包",
          "疑似派发钱包",
          "疑似利润回收钱包",
          "疑似核心资金源候选",
          "疑似接盘鲸鱼",
          "疑似结果钱包",
          "证据不足",
          "字段缺失",
          "需要链上补查"
        ]
      }
    },
    "decision_text_zh": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_items": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "requires_followup_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "gmgn_note": {
      "type": [
        "string",
        "null"
      ]
    },
    "watchlist_action": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}