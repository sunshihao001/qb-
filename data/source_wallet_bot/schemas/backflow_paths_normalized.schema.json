{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "backflow_paths_normalized.json",
  "type": "object",
  "description": "利润回流路径 normalized contract。",
  "additionalProperties": false,
  "required": [
    "token_address",
    "wallet_address",
    "has_backflow",
    "backflow_address",
    "schema_version",
    "source_level",
    "source_name",
    "normalized_at",
    "missing_fields",
    "fallback_used",
    "fallback_source"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "source_level": {
      "type": "string",
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3",
        "L4",
        "unknown"
      ]
    },
    "source_name": {
      "type": "string"
    },
    "raw_snapshot_time": {
      "type": [
        "string",
        "null"
      ]
    },
    "wallet_snapshot_time": {
      "type": [
        "string",
        "null"
      ]
    },
    "retrieved_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "normalized_at": {
      "type": "string"
    },
    "missing_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fallback_used": {
      "type": "boolean"
    },
    "fallback_source": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_level": {
      "type": "string",
      "enum": [
        "E0",
        "E1",
        "E2",
        "E3",
        "E4",
        "E5",
        "unknown"
      ]
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3",
        "R4",
        "unknown"
      ]
    },
    "token_address": {
      "type": [
        "string",
        "null"
      ]
    },
    "wallet_address": {
      "type": [
        "string",
        "null"
      ]
    },
    "sell_tx_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "sell_time": {
      "type": [
        "string",
        "null"
      ]
    },
    "backflow_time": {
      "type": [
        "string",
        "null"
      ]
    },
    "backflow_asset": {
      "type": [
        "string",
        "null"
      ]
    },
    "backflow_amount": {
      "type": [
        "number",
        "null"
      ]
    },
    "backflow_address": {
      "type": [
        "string",
        "null"
      ]
    },
    "backflow_tx_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "has_backflow": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "backflow_delay_seconds": {
      "type": [
        "integer",
        "null"
      ]
    }
  }
}